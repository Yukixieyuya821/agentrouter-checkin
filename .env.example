# AgentRouter 账号：单用户与多用户二选一
AGENTROUTER_USERNAME=
AGENTROUTER_PASSWORD=
# AGENTROUTER_ACCOUNTS=user1:pass1,user2:pass2

# 可选代理；支持逗号或换行分隔多个地址
SOCKS5_PROXY=

# SMTP 邮件通知
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=

# 发件人与收件人
EMAIL_FROM=sender@example.com
EMAIL_FROM_NAME=AgentRouter 签到机器人
EMAIL_TO=receiver@example.com
